# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------

# Public application URL. Used to build QR verification links, e.g. https://reports.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings -> API). The anon key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used ONLY for user invitation/administration and bootstrap scripts.
# Never expose to the browser; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only secret (>= 32 random bytes, base64/hex) used to derive QR verification tokens.
# Rotating it invalidates every issued QR code. Generate: openssl rand -base64 48
VERIFICATION_TOKEN_SECRET=replace-with-a-long-random-secret

# Passport OCR provider: "azure" (Azure AI Document Intelligence prebuilt-idDocument) or "mock".
# "mock" is for local development only and never reads the uploaded document.
OCR_PROVIDER=mock
# Mock behaviour: "specimen" (returns labelled specimen data) or "fail" (simulates an OCR failure)
OCR_MOCK_MODE=specimen
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-key
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30

# Upload limits
PASSPORT_MAX_FILE_MB=10

# Optional: path to a Chromium binary for PDF rendering (otherwise Playwright's bundled browser is used)
PDF_CHROMIUM_EXECUTABLE_PATH=
# "true" forces the bundled serverless Chromium (@sparticuz/chromium). Automatic on Vercel.
PDF_SERVERLESS_CHROMIUM=

# Rate limits (requests per minute per client IP)
RATE_LIMIT_VERIFY_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20
